{
  "name": "@aiweave/tantu",
  "version": "0.2.0",
  "description": "Tantu — a React design system that treats the interface as handloom cloth: token-driven, theme-aware, WCAG AA verified.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles/tantu.css",
    "./fonts.css": "./styles/fonts.css",
    "./tokens/tantu.tokens.json": "./tokens/tantu.tokens.json",
    "./tokens/tokens-studio.json": "./tokens/tokens-studio.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "fonts",
    "tokens",
    "README.md",
    "CHANGELOG.md",
    "VERSIONING.md",
    "ACCESSIBILITY-CONFORMANCE-REPORT.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "accessibility",
    "wcag",
    "design-tokens",
    "theming",
    "dark-mode",
    "rtl",
    "internationalization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajatarun/aiweave.git",
    "directory": "src/tantu"
  },
  "homepage": "https://github.com/rajatarun/aiweave/tree/main/src/tantu#readme",
  "bugs": {
    "url": "https://github.com/rajatarun/aiweave/issues"
  },
  "module": "./dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "cd ../.. && npm run verify"
  }
}
