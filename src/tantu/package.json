{
  "name": "@aiweave/tantu",
  "version": "0.1.0",
  "description": "Tantu \u2014 a React design system that treats the interface as handloom cloth: token-driven, theme-aware, WCAG AA verified.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./styles.css": "./styles/tantu.css",
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "hooks",
    "lib",
    "styles",
    "tokens",
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "VERSIONING.md",
    "ACCESSIBILITY-CONFORMANCE-REPORT.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "accessibility",
    "wcag",
    "design-tokens",
    "theming",
    "dark-mode",
    "rtl",
    "internationalization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajatarun/aiweave.git",
    "directory": "src/tantu"
  },
  "homepage": "https://github.com/rajatarun/aiweave/tree/main/src/tantu#readme",
  "bugs": {
    "url": "https://github.com/rajatarun/aiweave/issues"
  }
}
