{
  "name": "aiweave",
  "version": "1.0.0",
  "description": "AIWeave landing page generator built with native Tantu Design Library components",
  "type": "module",
  "scripts": {
    "audit": "npm run audit:a11y && npm run audit:bleed && npm run test",
    "audit:a11y": "node scripts/audit_a11y.mjs",
    "audit:bleed": "node scripts/verify_bleed_bus.mjs",
    "audit:browser": "node scripts/verify_browser.mjs",
    "audit:fonts": "python3 scripts/verify_style.py",
    "audit:stories": "node scripts/verify_storybook.mjs",
    "build": "npm run build:client-assets && tsx generate_site.jsx",
    "build:client-assets": "tsc --target es2020 --module es2020 --lib es2020,dom --noResolve --skipLibCheck --outDir assets src/tantu/lib/capillary-bleed.ts src/tantu/lib/maku-shuttle.ts src/tantu/lib/bleed-bus.ts src/tantu/lib/direction.ts",
    "build:fonts": "python3 build.py",
    "build:storybook": "storybook build -o storybook-static",
    "qa:playground": "node scripts/qa_playground.mjs",
    "playground": "npm --prefix playground run dev",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/export_tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify": "npm run typecheck && npm run test && npm run tokens && npm run audit:a11y && npm run audit:bleed && npm run build && npm run audit:browser && npm run build:storybook && npm run audit:stories"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "storybook": "^9.1.20",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
