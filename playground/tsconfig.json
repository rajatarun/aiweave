{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@weaveaijs/tantu": [
        "../src/tantu/index.ts"
      ],
      "@weaveaijs/tantu/styles.css": [
        "../src/tantu/styles/tantu.css"
      ],
      "@weaveaijs/tantu/fonts.css": [
        "../src/tantu/styles/fonts.css"
      ]
    }
  },
  "include": [
    "src"
  ]
}
